    "test": "npm run build && node --test test/webhooks.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  },
  "keywords": [
    "chains-erp",
    "fleetops",
    "logistics",
    "delivery",
    "storefront",
    "fleetbase",
    "sdk"
  ]
}
